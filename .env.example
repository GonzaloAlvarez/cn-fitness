# cn-fitness — copy to .env (gitignored). Use `./setup.sh --core` to
# auto-fill the shared infra values from passwords.lan:~/cn-vaultwarden/.env
# (SMTP, S3 bucket, WebDAV, ADMIN_EMAIL, etc.). Anything below that's still
# empty after --core is prompted for or auto-generated.

# ── Tailscale + Headscale ──────────────────────────────────────────────────
# Mint with: ssh hs.gn.al 'docker exec cloudnet-headscale-1 \
#   headscale preauthkeys create --user gonzaloalvarez --tags tag:svc --expiration 24h'
FITNESS_AUTHKEY=
HEADSCALE_DOMAIN=hs.gn.al
INFRA_VPS_TAILNET_IP=100.64.0.1

# ── Domains ────────────────────────────────────────────────────────────────
LAN_DOMAIN=kaiser.lan
LAB_DOMAIN=lab.gn.al
TAILNET_DOMAIN=ts.gn.al

# ── Step-CA + ops ──────────────────────────────────────────────────────────
PKI_IP=pki.lan
ADMIN_EMAIL=
TIMEZONE=America/New_York

# ── Postgres — superuser (created by postgres image on first init) ─────────
SPARKY_FITNESS_DB_NAME=sparkyfitness
SPARKY_FITNESS_DB_USER=sparky
SPARKY_FITNESS_DB_PASSWORD=
SPARKY_FITNESS_DB_HOST=172.30.1.10
SPARKY_FITNESS_DB_PORT=5432

# ── Postgres — limited app role (created by server bootstrap on first run) ─
SPARKY_FITNESS_APP_DB_USER=sparky_app
SPARKY_FITNESS_APP_DB_PASSWORD=

# ── SparkyFitness server ───────────────────────────────────────────────────
SPARKY_FITNESS_FRONTEND_URL=https://fitness.lab.gn.al
SPARKY_FITNESS_EXTRA_TRUSTED_ORIGINS=https://fitness.kaiser.lan,https://fitness.lab.gn.al
ALLOW_PRIVATE_NETWORK_CORS=true
SPARKY_FITNESS_LOG_LEVEL=INFO
SPARKY_FITNESS_FORCE_EMAIL_LOGIN=true

# Signup gate. Starts false so setup.sh can auto-create the admin user via
# POST /api/auth/sign-up/email, then flips to true. After that, new accounts
# must be created by an admin (or by re-flipping to false temporarily).
SPARKY_FITNESS_DISABLE_SIGNUP=false

# ── Security (setup.sh auto-generates if blank) ────────────────────────────
# SPARKY_FITNESS_API_ENCRYPTION_KEY: 64 hex chars (openssl rand -hex 32).
# BETTER_AUTH_SECRET: 32 base64 bytes (openssl rand -base64 32).
SPARKY_FITNESS_API_ENCRYPTION_KEY=
BETTER_AUTH_SECRET=

# ── SMTP — shared with cn-vaultwarden/cn-netbox (harvested by --core) ──────
SMTP_HOST=
SMTP_FROM=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SPARKY_FITNESS_EMAIL_SECURE=false
ALERT_EMAIL=

# ── Backup — shared S3 + raidnas WebDAV (harvested by --core) ──────────────
BACKUP_S3_BUCKET=cloudnet-lab-storage
BACKUP_AWS_ACCESS_KEY_ID=
BACKUP_AWS_SECRET_ACCESS_KEY=
BACKUP_AWS_REGION=us-east-2
BACKUP_WEBDAV_URL=http://raidnas.lan:5005
BACKUP_WEBDAV_USER=
BACKUP_WEBDAV_PASSWORD=

# ── Optional: Vision API (Gemini) for food-photo recognition ──────────────
# Uncomment + set key to enable. Outbound HTTPS only; no inbound surface.
# VISION_API_PROVIDER=gemini
# VISION_API_KEY=

# ── Optional: OIDC (homelab has no IdP yet) ────────────────────────────────
# Uncomment + fill to wire Authentik/Keycloak/etc. later.
# SPARKY_FITNESS_OIDC_AUTH_ENABLED=true
# SPARKY_FITNESS_OIDC_PROVIDER_SLUG=
# SPARKY_FITNESS_OIDC_PROVIDER_NAME=
# SPARKY_FITNESS_OIDC_ISSUER_URL=
# SPARKY_FITNESS_OIDC_CLIENT_ID=
# SPARKY_FITNESS_OIDC_CLIENT_SECRET=
# SPARKY_FITNESS_OIDC_SCOPE=openid email profile
# SPARKY_FITNESS_OIDC_AUTO_REGISTER=false
# SPARKY_FITNESS_OIDC_ADMIN_GROUP=Admin

# ── Optional: Garmin microservice / MCP server ─────────────────────────────
# Both deferred to v2. Garmin microservice is WIP upstream; MCP server is a
# Claude Desktop / Claude Code integration that can plug in later.
